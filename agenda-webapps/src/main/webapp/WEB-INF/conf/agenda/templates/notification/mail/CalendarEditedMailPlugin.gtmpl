<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.util.EmailLayout.dir(_ctx.language)}">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.CalendarEditedNotificationPlugin", _ctx.escapeHTML(calendarName)));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td style="padding:0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                <tr>
                    <td>
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                            <tr>
                                <td align="${io.meeds.portal.mail.util.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff;padding: 30px 0 10px 0;" dir="auto">
                                    <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="auto">
                                        <%
                                        String modifier = io.meeds.portal.mail.util.EmailLayout.entityLink(modifierName, null);
                                        String calendar = io.meeds.portal.mail.util.EmailLayout.entityLink(calendarName, agendaURL);
                                        String summary = io.meeds.portal.mail.util.EmailLayout.entityLink(changedEventSummary, null);
                                        // One sentence per kind of change; a
                                        // removal names no event when the
                                        // deleted one carried no summary
                                        String key = "Notification.agenda.calendar.edited.changed";
                                        if ("ADDED".equals(changeKind)) {
                                          key = "Notification.agenda.calendar.edited.added";
                                        } else if ("REMOVED".equals(changeKind)) {
                                          key = changedEventSummary == null || changedEventSummary.isEmpty()
                                                ? "Notification.agenda.calendar.edited.removed.untitled"
                                                : "Notification.agenda.calendar.edited.removed";
                                        }
                                        %>
                                        <%= "Notification.agenda.calendar.edited.removed.untitled".equals(key)
                                            ? _ctx.appRes(key, modifier, calendar)
                                            : _ctx.appRes(key, modifier, summary, calendar) %>
                                    </p>
                                    <p style="margin:0; color:#5d676d; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="auto">
                                        <%= _ctx.appRes("Notification.agenda.calendar.edited.explanation") %>
                                    </p>
                                    <div dir="${io.meeds.portal.mail.util.EmailLayout.dir(_ctx.language)}" style="margin: 20px 0 8px 0;">
                                        <%=io.meeds.portal.mail.util.EmailLayout.actionLink(_ctx.appRes("Notification.agenda.calendar.edited.open"), agendaURL, true)%>
                                    </div>
                                    <p style="margin:28px 0 0 0; color: #5d676d;font-size: 13px;font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()}">
                                        <%=io.meeds.portal.mail.util.EmailLayout.linkStyled(_ctx.appRes("Notification.label.footer", FOOTER_LINK))%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
