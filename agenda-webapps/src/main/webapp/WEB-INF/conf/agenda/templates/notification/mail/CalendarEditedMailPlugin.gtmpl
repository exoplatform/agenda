<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="#ffffff" align="center" style="background-color: #ffffff; font-size: 12px;color:#333333;line-height: 18px;font-family: HelveticaNeue, Helvetica, Arial, sans-serif;">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.CalendarEditedNotificationPlugin", _ctx.escapeHTML(calendarName)));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td bgcolor="#ffffff" style="background-color: #ffffff;">
            <table cellpadding="0" cellspacing="0" width="100%"  bgcolor="#ffffff" style="background-color: #ffffff; border-bottom:1px solid #d8d8d8;border-left:1px solid #d8d8d8;border-right:1px solid #d8d8d8;">
                <tr>
                    <td>
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="#ffffff" align="center" style="background-color: #ffffff; color:#333333;line-height:20px;">
                            <tr>
                                <td align="left" bgcolor="#ffffff" style="background-color: #ffffff;padding: 10px 0;">
                                    <p style="margin: 10px 0;"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <p style="margin: 10px 0 13px;">
                                        <%
                                        String bold = "color: #2f5e92; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif";
                                        String modifier = "<span style=\"" + bold + "\">" + _ctx.escapeHTML(modifierName) + "</span>";
                                        String calendar = "<span style=\"" + bold + "\">" + _ctx.escapeHTML(calendarName) + "</span>";
                                        String summary = "<span style=\"" + bold + "\">" + _ctx.escapeHTML(changedEventSummary) + "</span>";
                                        // One sentence per kind of change; a
                                        // removal names no event when the
                                        // deleted one carried no summary
                                        String key = "Notification.agenda.calendar.edited.changed";
                                        if ("ADDED".equals(changeKind)) {
                                          key = "Notification.agenda.calendar.edited.added";
                                        } else if ("REMOVED".equals(changeKind)) {
                                          key = changedEventSummary == null || changedEventSummary.isEmpty()
                                                ? "Notification.agenda.calendar.edited.removed.untitled"
                                                : "Notification.agenda.calendar.edited.removed";
                                        }
                                        %>
                                        <%= "Notification.agenda.calendar.edited.removed.untitled".equals(key)
                                            ? _ctx.appRes(key, modifier, calendar)
                                            : _ctx.appRes(key, modifier, summary, calendar) %>
                                    </p>
                                    <p style="margin: 0 0 13px; color:#999999;">
                                        <%= _ctx.appRes("Notification.agenda.calendar.edited.explanation") %>
                                    </p>
                                    <p style="margin: 0 0 20px;">
                                        <a target="_blank" style="
                                            display: inline-block;
                                            text-decoration: none;
                                            font-size: 11px;
                                            font-family:HelveticaNeue,arial,tahoma,serif;
                                            color: #333333;
                                            padding: 5px 8px;
                                            line-height: 100%;
                                            text-align: center;
                                            vertical-align: middle;"
                                           href="<%= agendaURL %>">
                                              <%= _ctx.appRes("Notification.agenda.calendar.edited.open") %>
                                        </a>
                                    </p>
                                    <p style="margin:30px 0 10px 0; color: #999999;font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif">
                                        <%=_ctx.appRes("Notification.label.footer", FOOTER_LINK)%>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
