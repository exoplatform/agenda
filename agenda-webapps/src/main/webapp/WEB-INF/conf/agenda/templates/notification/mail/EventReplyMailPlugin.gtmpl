<% def palette = org.exoplatform.commons.notification.mail.MailPalette.of(_templateContext) %>
<table border="0" cellpadding="0" cellspacing="0" width="600" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; font-size: 12px;color:${palette.text};line-height: 18px;font-family: HelveticaNeue, Helvetica, Arial, sans-serif;" class="mail-surface mail-text">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.AgendaInvitationPlugin.reply", eventTitle));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
            <table cellpadding="0" cellspacing="0" width="100%"  bgcolor="${palette.surface}" style="background-color: ${palette.surface}; border-bottom:1px solid ${palette.border};border-left:1px solid ${palette.border};border-right:1px solid ${palette.border};" class="mail-surface mail-border">
                <tr>
                    <td>
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; color:${palette.text};line-height:20px;" class="mail-surface mail-text">
                            <tr>
                                <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.surface};padding: 10px 0;" class="mail-surface">
                                    <p style="margin: 10px 0;"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <table border="0" cellpadding="0" cellspacing="0" >
                                        <tr>
                                            <td>
                                                <p style="margin: 10px 0 13px;">
                                                    <%
                                                    String eventTitle = "<span style=\"color: ${palette.link}; text-decoration: none; font-family: 'HelveticaNeue Bold', Helvetica, Arial, sans-serif\"  class=\"mail-link\">" + _ctx.escapeHTML(eventTitle) + "</span>";
                                                    String participantName = "<a class=\"user-name text-bold\">" + participantName +"</a>";
                                                    if (org.exoplatform.agenda.constant.EventAttendeeResponse.ACCEPTED.name().equals(responseType)) { %>
                                                      <%=  _ctx.appRes("Notification.agenda.event.reply.accepted", participantName, eventTitle) %>
                                                    <% } else if (org.exoplatform.agenda.constant.EventAttendeeResponse.DECLINED.name().equals(responseType)) { %>
                                                      <%=  _ctx.appRes("Notification.agenda.event.reply.declined", participantName, eventTitle) %>
                                                    <% } else if (org.exoplatform.agenda.constant.EventAttendeeResponse.WAITING.name().equals(responseType)) { %>
                                                      <%=  _ctx.appRes("Notification.agenda.event.reply.waiting", participantName, eventTitle) %>
                                                    <% } else { %>
                                                      <%=  _ctx.appRes("Notification.agenda.event.reply.mayBe", participantName, eventTitle) %>
                                                    <% } %>
                                                </p>
                                                <br/>
                                                <p style="margin: 0 0 20px;">
                                                    <a target="_blank" style="
                                                        display: inline-block;
                                                        text-decoration: none;
                                                        font-size: 11px;
                                                        font-family:HelveticaNeue,arial,tahoma,serif;
                                                        color: ${palette.text};
                                                        padding: 5px 8px;
                                                        line-height: 100%;
                                                        text-align: center;
                                                        vertical-align: middle;"
                                                       href="<%= eventURL %>" class="mail-text">
                                                          <%= _ctx.appRes("Notification.agenda.event.view") %>
                                                    </a>
                                                </p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr><!--end content area-->

    <!-- start content details -->
    <tr>
        <td bgcolor="${palette.surface}" style="background-color: ${palette.surface};" class="mail-surface">
            <table cellpadding="0" cellspacing="0" width="100%" bgcolor="${palette.surface}" style="background-color: ${palette.surface}; border-bottom:1px solid ${palette.border};border-left:1px solid ${palette.border};border-right:1px solid ${palette.border};" class="mail-surface mail-border">
                <tbody>
                <tr>
                    <td>
                        <table border="0" cellpadding="0" cellspacing="0" width="92%" bgcolor="${palette.surface}" align="center" style="background-color: ${palette.surface}; color:${palette.text};line-height:20px;" class="mail-surface mail-text">
                            <tbody>
                            <tr>
                            <tr>
                                <td style="font-family: 'HelveticaNeue Bold',Helvetica, Arial, sans-serif;font-size:13px;font-weight:bold"><%=_ctx.appRes("Notification.agenda.event.details")%></td>
                            </tr>
                            <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.surface};padding: 10px 0;" class="mail-surface">
                                <table border="0" cellpadding="0" cellspacing="0" width="100%"  align="left">
                                    <tbody>
                                    <tr>
                                        <td style="color:${palette.secondaryText}; font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif; font-weight:bold" class="mail-secondary-text"><%=_ctx.appRes("Notification.agenda.event.space.name")%></td>
                                        <td align="left"><%= agendaName %></td>
                                    </tr>
                                    <tr>
                                        <td style="color:${palette.secondaryText}; font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif; font-weight:bold" class="mail-secondary-text"><%=_ctx.appRes("Notification.agenda.event.date")%></td>
                                        <td align="left" ><%= _ctx.appRes("Notification.agenda.event.mail.body.date", monthYearDate, startDate, endDate) %> (<%= timeZoneName %>)</td>
                                    </tr>
                                    <tr>
                                        <td style="color:${palette.secondaryText}; font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif; font-weight:bold" class="mail-secondary-text"></td>
                                        <td align="left" style="color:${palette.secondaryText}; font-size:11px;font-family:HelveticaNeue,arial,tahoma,serif"  class="mail-secondary-text"><%= recurrenceDetails %></td>
                                    </tr>
                                    <tr>
                                        <td style="color:${palette.secondaryText}; font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif; font-weight:bold" class="mail-secondary-text"><%=_ctx.appRes("Notification.agenda.event.location")%></td>
                                        <td align="left"><%= eventLocation %></td>
                                    </tr>
                                    <tr>
                                        <td style="color:${palette.secondaryText}; font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif;font-weight:bold" class="mail-secondary-text"><%=_ctx.appRes("Notification.agenda.event.description")%></td>
                                        <td align="left"><%= eventDescription %></td>
                                    </tr>
                                    <tr>
                                        <td style="color:${palette.secondaryText}; font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif; font-weight:bold" class="mail-secondary-text"><%=_ctx.appRes("Notification.agenda.event.attendees")%></td>
                                        <td align="left"><%= attendees %></td>
                                    </tr>
                                    </tbody>
                                </table>
                                <tr>
                                    <td align="left" bgcolor="${palette.surface}" style="background-color: ${palette.surface};padding: 10px 0;" class="mail-surface">
                                        <p style="margin:30px 0 10px 0; color: ${palette.secondaryText};font-size:13px;font-family:HelveticaNeue,arial,tahoma,serif" class="mail-secondary-text">
                                            <%=_ctx.appRes("Notification.label.footer", FOOTER_LINK).replace("color: #2f5e92;", "color: ${palette.link};").replace("<a ", "<a class=\"mail-link\" ")%>
                                        </p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                </tbody>
            </table>
        </td>
    </tr>
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
