<%
  eventTitle = _ctx.escapeHTML(eventTitle);
%>
<div>
    <div class="contentSmall" data-link="<%= eventURL %>">
        <div class="status">
            <%
            String eventTitle = "<span class=\"user-name text-bold\">"+ eventTitle +"</span>";
            String participantName = "<a class=\"user-name text-bold\">" + participantName +"</a>";
            if (org.exoplatform.agenda.constant.EventAttendeeResponse.ACCEPTED.name().equals(responseType)) { %>
              <%=  _ctx.appRes("Notification.agenda.event.reply.accepted", participantName, eventTitle) %>
            <% } else if (org.exoplatform.agenda.constant.EventAttendeeResponse.DECLINED.name().equals(responseType)) { %>
              <%=  _ctx.appRes("Notification.agenda.event.reply.declined", participantName, eventTitle) %>
            <% } else if (org.exoplatform.agenda.constant.EventAttendeeResponse.WAITING.name().equals(responseType)) { %>
              <%=  _ctx.appRes("Notification.agenda.event.reply.waiting", participantName, eventTitle) %>
            <% } else { %>
              <%=  _ctx.appRes("Notification.agenda.event.reply.mayBe", participantName, eventTitle) %>
            <% } %>
        </div>
    </div>
</div>